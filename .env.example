# Credencial da service account do Google Earth Engine, exigida pelas rotas
# /api/gee/*. Em desenvolvimento, o caminho do JSON na maquina; no Render, o
# caminho do Secret File montado (ex.: /etc/secrets/gee-service-account.json).
# Nunca versionar o JSON nem o .env.local.
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\service-account.json

# Caminho absoluto do mesmo JSON no host, usado apenas por `docker compose`.
# O arquivo e montado como segredo em /run/secrets/gee-service-account.json.
# GEE_CREDENTIALS_FILE=/caminho/para/service-account.json

# Destino dos botoes que levam ao modulo de mapas e analises. Vazio ou ausente
# usa a rota interna /mapa; visitantes sem sessao sao enviados ao login.
# Por ser NEXT_PUBLIC_*, o valor e embutido no build (rebuild ao alterar).
# NEXT_PUBLIC_MAPA_URL=/mapa

# Configuracao publica da aplicacao Web no Firebase (Project settings > General).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Credenciais privadas da service account Firebase (Project settings > Service
# accounts). Nunca use NEXT_PUBLIC_ e nunca versione o JSON da chave.
# FIREBASE_PROJECT_ID= # opcional fora do Docker; no Compose, usa NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa a FIREBASE_PRIVATE_KEY para provedores com dificuldades em preservar
# quebras de linha: chave privada codificada em base64.
# FIREBASE_PRIVATE_KEY_BASE64=

# ID de metrica do Google Analytics (GA4), formato "G-XXXXXXXXXX". Ausente em
# desenvolvimento local; sem ele o componente <Analytics> nao renderiza nada.
# Por ser NEXT_PUBLIC_*, o valor e embutido no build (rebuild ao alterar).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Chave dos mapas base da CARTO, o Positron (claro) e o Dark Matter (escuro).
# Desde agosto de 2026 a CARTO exige chave nos tiles raster: a requisicao sem
# chave responde HTTP 200, mas o PNG chega estampado com a marca d'agua
# "API KEY REQUIRED". A chave e gratuita para uso nao comercial, com uso justo
# de 5 milhoes de tiles por mes, e sai em https://carto.com/basemaps/apikey
# Por ser NEXT_PUBLIC_*, o valor e embutido no build (rebuild ao alterar).
NEXT_PUBLIC_CARTO_KEY=

# Contentful, origem do conteudo editorial do site institucional: os textos
# da landing, de Sobre e de Comunicacao, a colecao de cartilhas, o caderno
# tematico em destaque e as fotos da formacao cidada. Sem
# estas variaveis a pagina renderiza o conteudo padrao que vem no codigo, que
# e como o build do CI roda. Nunca use o prefixo NEXT_PUBLIC_, que levaria o
# token ao navegador.
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=       # Content Delivery token (Settings > API keys)
# CONTENTFUL_ENVIRONMENT=master  # opcional; master e o padrao
# Previa do editor: exige as duas linhas. Com CONTENTFUL_PREVIEW=true e sem o
# token de previa, o codigo trata a configuracao como ausente.
# CONTENTFUL_PREVIEW=true
# CONTENTFUL_PREVIEW_TOKEN=
# Exclusivo do scripts/contentful-provision.mts, que cria os content types e
# semeia os textos (Settings > API keys > Content management tokens). A
# aplicacao nao usa.
# CONTENTFUL_MANAGEMENT_TOKEN=

# Cadastro e bloqueio de acesso (docs/signup.md). Todas exclusivas do servidor:
# nunca use o prefixo NEXT_PUBLIC_.
#
# Interruptor do bloqueio de acesso; tambem abre o cadastro. Ligue somente
# depois de rodar scripts/backfill-access-claims.mjs: antes disso, toda conta
# existente fica de fora.
PLATFORM_ACCESS_GUARD_ENABLED=false
# Dominios liberados sem aprovacao, separados por virgula (ex.: ufcg.edu.br).
# Vazio manda todo cadastro para a aprovacao.
SIGNUP_ALLOWED_DOMAINS=
# E-mails de quem decide os pedidos em /aprovacoes, separados por virgula.
ACCESS_ADMIN_EMAILS=
# Caixa compartilhada da equipe que recebe os pedidos novos.
OCA_NOTIFICATION_EMAIL=
# Conta de envio: SMTP do Gmail com senha de app. Sem ela os e-mails nao saem
# e o log registra; MAIL_LOG_BODY=true imprime o corpo, so em desenvolvimento
# (o link e uma credencial).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# MAIL_LOG_BODY=true
# Endereco publico do ambiente, para os links dos e-mails. Ausente em
# desenvolvimento, usa http://localhost:3000.
# APP_BASE_URL=
# Colecao do Firestore com os pedidos. Beta e producao usam access-requests;
# o padrao, access-requests-local, mantem os testes locais fora dela.
# FIREBASE_ACCESS_REQUESTS_COLLECTION=access-requests-local
# Envia o aviso de recusa a quem foi recusado.
# SIGNUP_SEND_REJECTION_EMAIL=false
